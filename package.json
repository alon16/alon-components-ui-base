{
  "name": "@alon16/components-ui-base",
  "version": "0.1.24",
  "description": "Componentes Vue 3 tematizables para portales web.",
  "private": false,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/styles.css",
    "./themes/violet.css": "./src/styles/themes/violet.css",
    "./themes/dark-example.css": "./src/styles/themes/dark-example.css"
  },
  "files": [
    "dist",
    "src/styles/themes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alon16/components-ui-base.git"
  },
  "bugs": {
    "url": "https://github.com/alon16/components-ui-base/issues"
  },
  "homepage": "https://github.com/alon16/components-ui-base#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite --config vite.playground.config.js",
    "build": "vite build && vue-tsc -p tsconfig.build.json --noCheck",
    "check:types": "vue-tsc --noEmit --noCheck",
    "check:playground-types": "vue-tsc --noEmit --noCheck -p tsconfig.playground.json",
    "check:consumer-types": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck scripts/check-types-consumer.ts",
    "format:check": "prettier --check .",
    "check:base-colors": "node scripts/check-base-colors.mjs"
  },
  "peerDependencies": {
    "@vuepic/vue-datepicker": "^14.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@vuepic/vue-datepicker": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vuepic/vue-datepicker": "^14.0.0",
    "prettier": "3.9.5",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.11"
  }
}